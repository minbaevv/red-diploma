# J.A.R.V.I.S. configuration. Copy to `.env` in the repo root (git-ignored).
# Every value is optional: without keys Jarvis runs on the local brain and the
# browser voice, so the feature stays fully usable offline.

# Claude Haiku 4.5 for free-form conversation (learning answers stay guarded).
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-haiku-4-5

# ElevenLabs voice. Without a key the frontend uses SpeechSynthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
