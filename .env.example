# J.A.R.V.I.S. configuration. Copy to `.env` in the repo root (git-ignored).
# Every value is optional: without keys and local models Jarvis still runs on
# the deterministic local brain and the browser voice.

# --- Local brain: Ollama (preferred when the server is reachable) ---
#   ollama serve
#   ollama pull qwen2.5:3b
# Kyrgyz replies always use the deterministic local brain: a 3B model
# produces pseudo-Kyrgyz, so it is not allowed to answer KG.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# auto | ollama | anthropic | local
JARVIS_LLM=auto

# --- Voice: Piper (preferred when the voices are installed) ---
#   py -3.13 -m pip install piper-tts
# Download commands for both voices are in README.md.
# auto | piper | elevenlabs | browser
JARVIS_TTS=auto
PIPER_VOICE_EN=backend/models/piper/en_GB-jarvis-high.onnx
PIPER_VOICE_RU=backend/models/piper/ru_RU-dmitri-medium.onnx
# Force one voice for every language. Only use a voice that matches the
# language: the English movie-JARVIS voice cannot read Russian or Kyrgyz.
# PIPER_VOICE=backend/models/piper/ru_RU-dmitri-medium.onnx
# PIPER_EXE=C:\path\to\piper.exe

# --- Optional cloud providers ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-haiku-4-5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
